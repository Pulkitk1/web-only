{
  "name": "consisto-web",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "firebase": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:rules": "npx -y firebase-tools@15.37.0 emulators:exec --only firestore --project demo-consisto --config firebase/emulator.json \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "node scripts/e2e-dashboard.mjs",
    "build:rules": "node scripts/build-rules.mjs",
    "seed:staging": "node scripts/seed-staging-data.mjs",
    "audit:data": "node scripts/audit-existing-data.mjs",
    "build:web": "expo export --platform web",
    "verify:build": "node scripts/verify-production-build.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
