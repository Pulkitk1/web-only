# Copy to .env.local (development) or provide these in the build environment (production). Never commit the real file.
# The six Firebase values are the web app's PUBLIC identifiers (Firebase Console > Project settings > Your apps > Web app). They are not
# secrets: access is controlled by Authentication, the Firestore rules, App Check and the API key restrictions. NEVER put a service
# account, a private key or any other credential in a variable starting with EXPO_PUBLIC_: it is copied into the public bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Guest import (Phase 10). MUST stay false for production until an Android build that reads `rewardsIgnoredThrough` is the build in use.
EXPO_PUBLIC_GUEST_IMPORT_ENABLED=false

# App Check (Phase 11B). Leave the site key empty to keep App Check off. provider: enterprise (reCAPTCHA Enterprise) or v3 (reCAPTCHA v3).
# The debug token is for DEVELOPMENT builds only and is ignored in a production build. Enforcement is switched on in the Firebase Console, never here.
EXPO_PUBLIC_APPCHECK_SITE_KEY=
EXPO_PUBLIC_APPCHECK_PROVIDER=enterprise
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Help & Support (Phase 12A). The address shown in Settings > Help & Support. Leave it empty until a real support address exists: the app then says that none
# has been set up yet (it never shows a made-up one). It is public by nature, because users see it.
EXPO_PUBLIC_SUPPORT_EMAIL=
